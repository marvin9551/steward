{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Steward: chat",
      "type": "debugpy",
      "request": "launch",
      "module": "steward",
      "args": ["chat"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Steward: chat (read-only)",
      "type": "debugpy",
      "request": "launch",
      "module": "steward",
      "args": ["chat", "--permission", "read-only"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Steward: chat (.env)",
      "type": "debugpy",
      "request": "launch",
      "module": "steward",
      "args": ["chat"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Steward: sessions",
      "type": "debugpy",
      "request": "launch",
      "module": "steward",
      "args": ["sessions"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Steward: web (8765)",
      "type": "debugpy",
      "request": "launch",
      "module": "steward",
      "args": ["web", "--no-open"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Steward: offline demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_demo.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Steward: unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
