# Copy to .env only if you prefer environment variables over config.toml.
# The "Steward: chat (.env)" launch configuration reads this file.
# .env is gitignored; never commit real keys.
#
# Note: a STEWARD_* variable set here pins that field — the web settings
# dialog then locks it and config.toml can never win. Set a variable only
# when you really want it enforced; base_url and model usually belong in
# config.toml instead.
STEWARD_API_KEY=
# STEWARD_BASE_URL=https://api.deepseek.com/v1
# STEWARD_MODEL=deepseek-chat
# STEWARD_WORKSPACE=~/.steward/workspace
# STEWARD_DATA_DIR=~/.steward
# STEWARD_PERMISSION=workspace-write
